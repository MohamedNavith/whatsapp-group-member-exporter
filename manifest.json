{
  "manifest_version": 3,
  "name": "WA Group Member Exporter",
  "version": "1.0.0",
  "description": "Export participant information available in WhatsApp Web to CSV and XLSX format.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "WA Group Member Exporter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "exporter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
